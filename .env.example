DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require

# demo runs the local simulator; razorpay_test opens official Razorpay Test Mode.
PAYMENT_MODE=demo
# Only required when PAYMENT_MODE=razorpay_test. Never put the secret in NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=