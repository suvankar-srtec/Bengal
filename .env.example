DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require

# UPI payment QR configuration.
# Example only: replace with the real merchant/recipient UPI ID in Vercel.
PAYMENT_UPI_ID=merchant@bank
PAYMENT_PAYEE_NAME=Bengal Business Council

# Server-only WhatsApp delivery. The public app must serve the new pass routes.
APP_PUBLIC_URL=https://bengal-bbc.vercel.app
WAPMONKEY_API_KEY=
WAPMONKEY_DEVICE_TOKEN=

# Browser-restricted Google Maps key: Maps JavaScript, Places API (New), Geocoding API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional custom map ID; the picker otherwise uses the Google demo map ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
