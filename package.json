{
  "name": "bengal-business-council-registration",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/registration.test.ts tests/payment-security.test.ts",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "test:integration": "node --env-file=.env.local scripts/verify-registration.mjs",
    "test:payments": "node --env-file=.env.local scripts/verify-payments.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
